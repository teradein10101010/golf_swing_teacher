# Backend runtime
FREE_ACCESS=1
FRONTEND_ORIGIN=http://localhost:5173
# CORS_ORIGINS can be comma-separated, e.g. http://localhost:5173,https://example.com
CORS_ORIGINS=http://localhost:5173
MEDIA_TOKEN_SECRET=replace_with_a_long_random_secret
MEDIA_TOKEN_TTL_SECONDS=3600

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Backend public origin (used to build webhook URL)
BACKEND_ORIGIN=https://api.example.com
# Optional: recurring monthly price created in Stripe Dashboard (price_xxx)
# If omitted, backend uses a default 500 JPY / month price_data.
STRIPE_SUBSCRIPTION_PRICE_ID=price_xxx
# Optional: Stripe trial period for the subscription checkout. Defaults to 30 days.
STRIPE_SUBSCRIPTION_TRIAL_PERIOD_DAYS=30

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Contact form storage (Supabase table: contact_inquiries)
