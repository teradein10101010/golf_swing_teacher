# Backend runtime
FREE_ACCESS=1
FRONTEND_ORIGIN=http://localhost:5173
# CORS_ORIGINS can be comma-separated, e.g. http://localhost:5173,https://example.com
CORS_ORIGINS=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Contact form mail delivery (SMTP)
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=your_smtp_user
CONTACT_SMTP_PASSWORD=your_smtp_password
CONTACT_SMTP_STARTTLS=1
CONTACT_FROM_EMAIL=no-reply@example.com
CONTACT_TO_EMAIL=support@example.com
